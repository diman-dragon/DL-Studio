  "theory": [
    {
      "h": "Ближайшие родственники",
      "p": [
        "**mother** (в речи — _mum_), **father** (_dad_), **sister**, **brother**. Вместе мать и отца называют **parents**.",
        "**grandmother** и **grandfather** — бабушка и дедушка, вместе **grandparents**."
      ]
    },
    {
      "h": "Чья это семья",
      "p": [
        "Принадлежность выражают словами **my**, **your**, **his**, **her**: **my mother**, **his sister**, **her brother**."
      ]
    }
  ],
