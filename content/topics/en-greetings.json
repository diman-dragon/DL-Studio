{
  "id": "en-greetings",
  "course": "English",
  "group": "A1",
  "n": 1,
  "title": "Приветствия и знакомство",
  "tag": "en-US",
  "theory": [
    {
      "h": "Как поздороваться",
      "p": [
        "**Hello** и **Hi** подходят почти всегда; _Hi_ звучит проще и дружелюднее.",
        "По времени суток: **Good morning** — до полудня, **Good afternoon** — днём, **Good evening** — вечером. **Good night** говорят, когда прощаются перед сном."
      ]
    },
    {
      "h": "Знакомство",
      "p": [
        "Назвать себя: **My name is Anna.** Короче: **I'm Anna.**",
        "Спросить имя: **What's your name?** На фразу **Nice to meet you** отвечают **Nice to meet you, too.**"
      ]
    },
    {
      "h": "Как дела и прощание",
      "p": [
        "**How are you?** — «Как дела?» Ответ: **I'm fine, thank you. And you?**",
        "Попрощаться можно так: **Goodbye**, **Bye** или **See you later** (до скорой встречи)."
      ]
    }
  ],
  "cards": [
    {
      "front": "Hello",
      "back": "Привет, здравствуйте",
      "ipa": "/həˈləʊ/",
      "example": "Hello, my name is Tom."
    },
    {
      "front": "Good morning",
      "back": "Доброе утро",
      "ipa": "/ˌɡʊd ˈmɔːnɪŋ/",
      "example": "Good morning, everyone!"
    },
    {
      "front": "Good evening",
      "back": "Добрый вечер",
      "ipa": "/ˌɡʊd ˈiːvnɪŋ/",
      "example": "Good evening, Mr Brown."
    },
    {
      "front": "Goodbye",
      "back": "До свидания",
      "ipa": "/ˌɡʊdˈbaɪ/",
      "example": "Goodbye, see you tomorrow."
    },
    {
      "front": "Thank you",
      "back": "Спасибо",
      "ipa": "/ˈθæŋk juː/",
      "example": "Thank you very much."
    },
    {
      "front": "Please",
      "back": "Пожалуйста (просьба)",
      "ipa": "/pliːz/",
      "example": "A glass of water, please."
    },
    {
      "front": "Nice to meet you",
      "back": "Приятно познакомиться",
      "ipa": "/ˌnaɪs tə ˈmiːt juː/",
      "example": "Nice to meet you, Anna."
    },
    {
      "front": "How are you?",
      "back": "Как дела?",
      "ipa": "/ˌhaʊ ɑː ˈjuː/",
      "example": "Hi! How are you?"
    }
  ],
